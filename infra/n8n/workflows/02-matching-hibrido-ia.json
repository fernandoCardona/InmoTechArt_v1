          }
        ]
      ]
    },
    "Filtro (> 70% Match)": {
      "main": [
        [
          {
            "node": "Guardar Matches (PostgreSQL)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardar Matches (PostgreSQL)": {
      "main": [
        [
          {
            "node": "Loop (Por cada Cliente)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}