{
  "name": "Neretxaus - 2. Motor de Matching IA (Híbrido)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "e81d7d06-c89b-44ec-b4c4-72213490aa5e",
      "name": "Cron (Cada 6h) o Webhook",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [ 100, 300 ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM app_core.client_search_profiles c JOIN app_core.clients cl ON c.client_id = cl.id WHERE cl.is_active = true;"
      },
      "id": "2db4c6a9-8df0-4b36-9b51-518db671a5af",
      "name": "Obtener Clientes y Perfiles",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [ 300, 300 ]
    },
    {
      "parameters": {},
      "id": "c61b2a95-ef20-4e3a-ae9a-5e8c454e99f9",
      "name": "Loop (Por cada Cliente)",
      "type": "n8n-nodes-base.loop",
      "typeVersion": 1,
      "position": [ 500, 300 ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT * FROM assets.properties \nWHERE is_active = true \nAND precio_venta <= {{ $json.presupuesto_maximo || 999999999 }}\nAND (provincia = '{{ $json.provincia }}' OR '{{ $json.provincia }}' = 'null' OR '{{ $json.provincia }}' = '')\nAND created_at >= NOW() - INTERVAL '7 DAYS'\nLIMIT 50;"
      },
      "id": "d0fbc765-b1ab-4318-8f5b-b9f1dcf752c0",
      "name": "Pre-Filtro SQL Rápido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [ 700, 300 ]
    },
    {
      "parameters": {
        "model": "qwen2.5:7b-instruct",
        "prompt": "=Eres un experto inmobiliario. Cruza el perfil del cliente: \"{{ $('Loop (Por cada Cliente)').item.json.descripcion_ia }}\" con este activo: {{ JSON.stringify($json) }}. Devuelve un JSON con 'match_score' (0-100) y 'match_reason' (texto explicativo corto).",
        "jsonOutput": true
      },
      "id": "893c5d88-ec94-4d1a-be87-512c1e48e898",
      "name": "Ollama (Evaluación IA)",
      "type": "n8n-nodes-base.ollama",
      "typeVersion": 1,
      "position": [ 900, 300 ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.match_score }}",
              "operation": "largest",
              "value2": 70
            }
          ]
        }
      },
      "id": "c35d69eb-6f4a-4d2c-8822-482bcbd9a3df",
      "name": "Filtro (> 70% Match)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 1100, 300 ]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "app_core",
        "table": "asset_matches",
        "columns": "client_id,property_id,match_score,match_reason",
        "returnFields": false
      },
      "id": "a92d4f23-8c10-4f53-8328-984b91f0e4b8",
      "name": "Guardar Matches (PostgreSQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [ 1300, 200 ]
    }
  ],
  "connections": {
    "Cron (Cada 6h) o Webhook": {
      "main": [
        [ { "node": "Obtener Clientes y Perfiles", "type": "main", "index": 0 } ]
      ]
    },
    "Obtener Clientes y Perfiles": {
      "main": [
        [ { "node": "Loop (Por cada Cliente)", "type": "main", "index": 0 } ]
      ]
    },
    "Loop (Por cada Cliente)": {
      "main": [
        [ { "node": "Pre-Filtro SQL Rápido", "type": "main", "index": 0 } ]
      ]
    },
    "Pre-Filtro SQL Rápido": {
      "main": [
        [ { "node": "Ollama (Evaluación IA)", "type": "main", "index": 0 } ]
      ]
    },
    "Ollama (Evaluación IA)": {
      "main": [
        [ { "node": "Filtro (> 70% Match)", "type": "main", "index": 0 } ]
      ]
    },
    "Filtro (> 70% Match)": {
      "main": [
        [ { "node": "Guardar Matches (PostgreSQL)", "type": "main", "index": 0 } ],
        [ { "node": "Loop (Por cada Cliente)", "type": "main", "index": 0 } ]
      ]
    },
    "Guardar Matches (PostgreSQL)": {
      "main": [
        [ { "node": "Loop (Por cada Cliente)", "type": "main", "index": 0 } ]
      ]
    }
  },
  "active": true
}
